{
  "name": "cosmosyy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings -D correctness -D perf -A no-console src/",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "validate-content": "echo \"no content yet\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "26.1.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "3.2.4"
  }
}
